---
import { Image } from 'astro:assets';
import { contact, profile, socials } from '../data/portfolio';

import photo from '../assets/misc/photo.png';
import statusDot from '../assets/icons/status-dot.svg';
import smsTracking from '../assets/icons/sms-tracking.svg';
import arrowLeft from '../assets/icons/arrow-left.svg';
import copy from '../assets/icons/copy.svg';
import tick from '../assets/icons/tick.svg';
---

<!--
	Floating profile pinned bottom-left. The card is always rendered; in its
	resting state a clip-path reveals only the avatar, and hovering (or focusing
	inside) unclips it so the card grows upward from the avatar. While the message
	form (or its sent confirmation) is showing, the card stays unclipped until it's closed.
-->
<aside class="profile" aria-label="About me">
	<div class="profile-card" tabindex="0">
		<div class="profile-top">
			<div class="profile-actions">
				<div class="profile-buttons">
					<button class="profile-compose" type="button" aria-expanded="false" aria-controls="profile-form">
						<img src={smsTracking.src} width="20" height="20" alt="" />
						Write a message
					</button>
					<button class="profile-copy" type="button" data-email={contact.email}>
						<span class="profile-copy-icons" aria-hidden="true">
							<img src={copy.src} width="20" height="20" alt="" />
							<img src={tick.src} width="20" height="20" alt="" />
						</span>
						<span class="profile-copy-label">Copy email</span>
					</button>
					<p class="visually-hidden profile-copy-status" role="status"></p>
				</div>
				<ul class="profile-socials">
					{
						socials.map(({ label, href, icon }) => (
							<li>
								<a href={href} aria-label={label} target="_blank" rel="noopener noreferrer">
									<img src={icon.src} width={icon.width} height={icon.height} alt="" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<form
				class="profile-form"
				id="profile-form"
				aria-labelledby="profile-form-title"
				tabindex="-1"
				novalidate
				hidden
			>
				<div class="profile-form-header">
					<button class="profile-back" type="button" aria-label="Back">
						<img src={arrowLeft.src} width="20" height="20" alt="" />
					</button>
					<h2 class="profile-form-title" id="profile-form-title">Write a message</h2>
				</div>
				<div class="field">
					<label for="message-name">Name</label>
					<input
						id="message-name"
						name="name"
						type="text"
						placeholder="Jane Doe"
						autocomplete="name"
						spellcheck="false"
						required
					/>
					<p class="field-error" id="message-name-error" hidden></p>
				</div>
				<div class="field">
					<label for="message-email">Email</label>
					<input
						id="message-email"
						name="email"
						type="email"
						placeholder="you@site.com"
						autocomplete="email"
						spellcheck="false"
						autocapitalize="off"
						required
					/>
					<p class="field-error" id="message-email-error" hidden></p>
				</div>
				<div class="field">
					<label for="message-body">Message</label>
					<textarea
						id="message-body"
						name="message"
						rows="4"
						placeholder="What are you building, and when do you need it?"
						required></textarea>
					<p class="field-error" id="message-body-error" hidden></p>
				</div>
				<!-- Honeypot: off-screen and out of the tab order, so only bots fill it in. -->
				<div class="visually-hidden" aria-hidden="true">
					<label>Company <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
				</div>
				<!-- Turnstile renders here, and only shows itself when Cloudflare wants an interaction. -->
				<div class="profile-turnstile" hidden></div>
				<button class="profile-send" type="submit" aria-keyshortcuts="Meta+Enter Control+Enter">
					<span class="profile-send-label">Send message</span>
					<kbd class="profile-shortcut" aria-hidden="true">⌘↵</kbd>
				</button>
				<p class="field-error profile-form-status" role="alert" hidden></p>
			</form>

			<div
				class="profile-sent"
				role="group"
				aria-labelledby="profile-sent-title"
				aria-describedby="profile-sent-text"
				tabindex="-1"
				hidden
			>
				<h2 class="profile-sent-title" id="profile-sent-title">Message sent</h2>
				<p class="profile-sent-text" id="profile-sent-text"></p>
				<button class="profile-done" type="button">Done</button>
			</div>
		</div>
		<div class="profile-divider"></div>
		<div class="profile-details">
			<div class="profile-avatar">
				<Image src={photo} alt="" width={44} densities={[1, 2, 3]} class="profile-photo" />
			</div>
			<div class="profile-identity">
				<p class="profile-name">{profile.name}</p>
				<p class="profile-headline">{profile.headline}</p>
			</div>
		</div>
	</div>
	<!-- Outside the card so the resting clip-path (a circle around the avatar) doesn't cut it. -->
	<img class="profile-status" src={statusDot.src} width={statusDot.width} height={statusDot.height} alt="" />
</aside>

<script>
	import { actions, isInputError } from 'astro:actions';
	import { TURNSTILE_SITE_KEY } from 'astro:env/client';

	interface Turnstile {
		render(container: HTMLElement, options: Record<string, unknown>): string;
		getResponse(widgetId: string): string | undefined;
		reset(widgetId: string): void;
	}

	const root = document.querySelector<HTMLElement>('.profile')!;
	const top = root.querySelector<HTMLElement>('.profile-top')!;
	const actionsPanel = root.querySelector<HTMLElement>('.profile-actions')!;
	const compose = root.querySelector<HTMLButtonElement>('.profile-compose')!;
	const form = root.querySelector<HTMLFormElement>('.profile-form')!;
	const back = root.querySelector<HTMLButtonElement>('.profile-back')!;
	const send = root.querySelector<HTMLButtonElement>('.profile-send')!;
	const sendLabel = root.querySelector<HTMLElement>('.profile-send-label')!;
	const status = root.querySelector<HTMLElement>('.profile-form-status')!;
	const turnstileBox = root.querySelector<HTMLElement>('.profile-turnstile')!;
	const sent = root.querySelector<HTMLElement>('.profile-sent')!;
	const sentText = root.querySelector<HTMLElement>('.profile-sent-text')!;
	const done = root.querySelector<HTMLButtonElement>('.profile-done')!;
	const panels = [actionsPanel, form, sent];

	const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field :is(input, textarea)')];
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const touch = matchMedia('(pointer: coarse)');

	if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
		root.querySelector('.profile-shortcut')!.textContent = 'Ctrl ↵';
	}

	const messages: Record<string, (field: HTMLInputElement | HTMLTextAreaElement) => string> = {
		name: () => 'Enter your name so I know who’s writing',
		email: (field) =>
			field.validity.valueMissing ? 'Enter your email so I can reply' : 'Your email needs an @ and a domain, like you@site.com',
		message: () => 'Write a message before sending',
	};

	let resize: Animation | undefined;

	// Animates `.profile-top` between the heights of the panels as one swaps for another.
	// A swap that interrupts another starts from the current height, but the running animation is
	// cancelled before measuring, so the target is the new panel's real height.
	function show(next: HTMLElement) {
		const from = top.offsetHeight;
		resize?.cancel();
		root.toggleAttribute('data-composing', next !== actionsPanel);
		for (const panel of panels) panel.hidden = panel !== next;
		compose.setAttribute('aria-expanded', String(next === form));
		if (reducedMotion.matches) return;

		const to = top.offsetHeight;
		const easing = 'cubic-bezier(0.23, 1, 0.32, 1)';
		resize = top.animate({ height: [`${from}px`, `${to}px`] }, { duration: next === actionsPanel ? 200 : 280, easing });
		next.animate(
			{ opacity: [0, 1], filter: ['blur(4px)', 'blur(0px)'] },
			{ duration: 200, delay: 60, easing: 'ease-out', fill: 'backwards' },
		);
	}

	// On touch, focusing a field would throw the keyboard up unasked, so focus lands on the form
	// itself. Elsewhere it goes to the first field still empty, which picks up a kept draft.
	function openForm() {
		show(form);
		renderTurnstile();
		const target = touch.matches ? form : (fields.find((field) => !field.value.trim()) ?? fields[0]);
		target.focus({ preventScroll: true });
	}

	function close() {
		show(actionsPanel);
		compose.focus({ preventScroll: true });
	}

	function setFieldError(field: HTMLInputElement | HTMLTextAreaElement, message?: string) {
		const error = form.querySelector<HTMLElement>(`#${field.id}-error`)!;
		field.setAttribute('aria-invalid', String(Boolean(message)));
		if (message) {
			field.setAttribute('aria-describedby', error.id);
			error.textContent = message;
		} else {
			field.removeAttribute('aria-describedby');
		}
		error.hidden = !message;
	}

	function validate(field: HTMLInputElement | HTMLTextAreaElement) {
		const valid = field.checkValidity() && field.value.trim() !== '';
		setFieldError(field, valid ? undefined : messages[field.name](field));
		return valid;
	}

	function setStatus(message?: string) {
		status.textContent = message ?? '';
		status.hidden = !message;
	}

	// The spam check loads the first time the form opens, so the page itself ships no third-party script.
	let turnstileLoad: Promise<Turnstile> | undefined;
	let widgetId: string | undefined;

	function renderTurnstile() {
		turnstileLoad ??= new Promise((resolve, reject) => {
			const script = document.createElement('script');
			script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
			script.async = true;
			script.onload = () => resolve((window as unknown as { turnstile: Turnstile }).turnstile);
			script.onerror = reject;
			document.head.append(script);
		});
		turnstileLoad
			.then((turnstile) => {
				widgetId ??= turnstile.render(turnstileBox, {
					sitekey: TURNSTILE_SITE_KEY,
					action: 'contact',
					appearance: 'interaction-only',
					// The card is narrower than the 300px normal widget.
					size: 'compact',
					// The widget lives in a closed shadow root, so CSS can't tell when it's showing.
					'before-interactive-callback': () => (turnstileBox.hidden = false),
					'after-interactive-callback': () => (turnstileBox.hidden = true),
				});
			})
			.catch(() => {});
	}

	async function turnstileToken() {
		const turnstile = await turnstileLoad?.catch(() => undefined);
		return turnstile && widgetId ? turnstile.getResponse(widgetId) : undefined;
	}

	// Tokens are single-use, so every attempt that reached the server needs a fresh one.
	async function resetTurnstile() {
		const turnstile = await turnstileLoad?.catch(() => undefined);
		if (turnstile && widgetId) turnstile.reset(widgetId);
	}

	let sending = false;

	// aria-disabled rather than disabled, so the button keeps focus while the message is in flight.
	function setSending(on: boolean) {
		sending = on;
		send.setAttribute('aria-disabled', String(on));
		sendLabel.textContent = on ? 'Sending…' : 'Send message';
	}

	const copyButton = root.querySelector<HTMLButtonElement>('.profile-copy')!;
	const copyLabel = root.querySelector<HTMLElement>('.profile-copy-label')!;
	const copyStatus = root.querySelector<HTMLElement>('.profile-copy-status')!;
	let copyReset: number | undefined;

	// If the clipboard is off limits, the label shows the address instead, so it can still be read off.
	copyButton.addEventListener('click', async () => {
		const email = copyButton.dataset.email!;
		const copied = await navigator.clipboard?.writeText(email).then(
			() => true,
			() => false,
		);
		clearTimeout(copyReset);
		copyButton.toggleAttribute('data-copied', Boolean(copied));
		copyLabel.textContent = copied ? 'Email copied' : email;
		copyStatus.textContent = copied ? `Copied ${email}` : '';
		copyReset = window.setTimeout(() => {
			copyButton.removeAttribute('data-copied');
			copyLabel.textContent = 'Copy email';
			copyStatus.textContent = '';
		}, copied ? 2000 : 6000);
	});

	compose.addEventListener('click', openForm);
	back.addEventListener('click', close);
	done.addEventListener('click', close);

	// iOS leaves focus where it is when a tap lands on something that can't take it, so a tap on
	// empty space wouldn't fold the card. The message form stays open until it's closed, as elsewhere.
	document.addEventListener('pointerdown', (event) => {
		if (root.hasAttribute('data-composing') || root.contains(event.target as Node)) return;
		if (root.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
	});

	// A second tap on the photo folds the open card. Whether it was open is read on the way down,
	// since by the click the tap has already focused it.
	const avatar = root.querySelector<HTMLElement>('.profile-avatar')!;
	let retap = false;
	avatar.addEventListener('pointerdown', (event) => {
		retap = event.pointerType !== 'mouse' && !root.hasAttribute('data-composing') && root.contains(document.activeElement);
	});
	avatar.addEventListener('click', () => {
		if (retap) (document.activeElement as HTMLElement).blur();
		retap = false;
	});

	root.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && root.hasAttribute('data-composing')) close();
	});

	// Check a field once the visitor moves on from it, but not one they skipped past empty, and not
	// when they're leaving through Back or the form is closing.
	form.addEventListener('focusout', (event) => {
		const field = event.target as HTMLInputElement | HTMLTextAreaElement;
		if (!fields.includes(field) || form.hidden || event.relatedTarget === back) return;
		if (field.value.trim()) validate(field);
	});

	// Once a field has shown an error, re-check it as the visitor fixes it.
	form.addEventListener('input', (event) => {
		const field = event.target as HTMLInputElement | HTMLTextAreaElement;
		if (field.getAttribute('aria-invalid') === 'true') validate(field);
	});

	// Cmd/Ctrl+Enter sends from the message box, where plain Enter adds a line.
	form.addEventListener('keydown', (event) => {
		if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
			event.preventDefault();
			form.requestSubmit();
		}
	});

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (sending) return;
		setStatus();

		const invalid = fields.filter((field) => !validate(field));
		if (invalid.length) {
			invalid[0].focus();
			return;
		}

		if (!(await turnstileToken())) {
			setStatus(
				turnstileLoad
					? 'Still checking you’re not a bot. Try again in a moment.'
					: 'The spam check couldn’t load. If a content blocker is on, allow challenges.cloudflare.com.',
			);
			return;
		}

		setSending(true);
		const formData = new FormData(form);
		const result = await actions.sendMessage(formData).catch(() => undefined);
		setSending(false);
		resetTurnstile();

		if (!result) {
			setStatus('Your message didn’t send. Check your connection, then try again. It’s still here.');
			return;
		}
		const { error } = result;
		if (isInputError(error)) {
			const rejected = fields.filter((field) => error.fields[field.name as keyof typeof error.fields]);
			for (const field of rejected) setFieldError(field, messages[field.name](field));
			if (rejected.length) rejected[0].focus();
			else setStatus('The spam check didn’t finish. Try again.');
			return;
		}
		if (error) {
			setStatus(
				error.code === 'FORBIDDEN'
					? 'The spam check didn’t pass. Try again.'
					: 'Your message didn’t send. It’s still here, so try again in a moment.',
			);
			return;
		}

		sentText.textContent = `Thanks, ${String(formData.get('name')).trim()}. I’ll reply to ${formData.get('email')} soon.`;
		form.reset();
		for (const field of fields) setFieldError(field);
		show(sent);
		sent.focus({ preventScroll: true });
	});
</script>

<style>
	/*
	 * A filter rather than box-shadow, so the shadow follows the clip-path from avatar circle to card.
	 * Blur runs at twice the offset to keep it diffuse. The resting stack is scaled to the 44px
	 * avatar and lifts into the open one; both have three layers so the filter can interpolate.
	 */
	.profile {
		/* Grace period before collapsing, so a cursor slipping just off the edge doesn't fold the card. */
		--close-delay: 150ms;
		--shadow-rest: drop-shadow(0 0.5px 0.5px rgb(0 0 0 / 0.04)) drop-shadow(0 1px 3px rgb(0 0 0 / 0.05))
			drop-shadow(0 3px 6px rgb(0 0 0 / 0.03));
		--shadow-open: drop-shadow(0 0.5px 0.5px rgb(0 0 0 / 0.04)) drop-shadow(0 4px 8px rgb(0 0 0 / 0.04))
			drop-shadow(0 12px 24px rgb(0 0 0 / 0.05));
		position: fixed;
		left: 11px;
		bottom: 11px;
		z-index: 10;
		/*
		 * The box is the open card's size even while only the avatar shows, so it lets the pointer
		 * through; the card takes it back, and its clip-path keeps the resting hit area to the avatar.
		 */
		pointer-events: none;
		filter: var(--shadow-rest);
		transition: filter 200ms ease-out var(--close-delay);
	}

	.profile:has(.profile-card:focus-within),
	.profile[data-composing] {
		filter: var(--shadow-open);
		transition: filter 280ms var(--ease-out);
	}

	.profile-card {
		pointer-events: auto;
		/* Avatar box: 1px border + 12px padding from the card's bottom-left corner. */
		--avatar-inset: 13px;
		--avatar: 44px;
		/*
		 * Concentric with what sits in the corners: the avatar (22px radius) at the bottom and the
		 * compose pill (20px) at the top, each 13px in. 22 + 13 = 35px.
		 */
		--radius: calc(var(--avatar) / 2 + var(--avatar-inset));
		display: flex;
		flex-direction: column;
		/* Keeps the 11px gutter on both sides on screens narrower than the card. */
		width: min(320px, 100vw - 22px);
		background: var(--color-surface);
		border: 1px solid var(--color-hairline);
		border-radius: var(--radius);
		clip-path: inset(
			calc(100% - var(--avatar-inset) - var(--avatar)) calc(100% - var(--avatar-inset) - var(--avatar))
				var(--avatar-inset) var(--avatar-inset) round 22px
		);
		transition: clip-path 200ms ease-out var(--close-delay);
		outline: none;
	}

	.profile-card:focus-within,
	.profile[data-composing] .profile-card {
		clip-path: inset(0 0 0 0 round var(--radius));
		transition: clip-path 280ms var(--ease-out);
	}

	.profile-card:focus-visible {
		outline: 2px solid #4988c4;
		outline-offset: -2px;
	}

	/* Blurs as it fades, so the content resolves into focus rather than just appearing. */
	.profile-top,
	.profile-divider,
	.profile-identity {
		opacity: 0;
		filter: blur(4px);
		transition:
			opacity 150ms ease-out var(--close-delay),
			filter 150ms ease-out var(--close-delay);
	}

	/* `none` rather than blur(0), so the open content isn't left on a filter layer. */
	.profile-card:focus-within :is(.profile-top, .profile-divider, .profile-identity),
	.profile[data-composing] :is(.profile-top, .profile-divider, .profile-identity) {
		opacity: 1;
		filter: none;
		transition-duration: 250ms;
		transition-delay: 60ms;
	}

	/* Hover opens it only with a pointer that can hover; on touch a tap's :hover sticks and holds it open. */
	@media (hover: hover) {
		.profile:has(.profile-card:hover) {
			filter: var(--shadow-open);
			transition: filter 280ms var(--ease-out);
		}

		.profile-card:hover {
			clip-path: inset(0 0 0 0 round var(--radius));
			transition: clip-path 280ms var(--ease-out);
		}

		.profile-card:hover :is(.profile-top, .profile-divider, .profile-identity) {
			opacity: 1;
			filter: none;
			transition-duration: 250ms;
			transition-delay: 60ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.profile,
		.profile:has(.profile-card:hover, .profile-card:focus-within),
		.profile[data-composing],
		.profile-card,
		.profile-card:hover,
		.profile-card:focus-within,
		.profile[data-composing] .profile-card,
		.profile-top,
		.profile-divider,
		.profile-identity,
		.profile-card:hover :is(.profile-top, .profile-divider, .profile-identity),
		.profile-card:focus-within :is(.profile-top, .profile-divider, .profile-identity),
		.profile[data-composing] :is(.profile-top, .profile-divider, .profile-identity) {
			transition: none;
		}
	}

	/* Sits on the avatar's bottom-right: avatar offset (13px) + 30px in, 2px past its bottom edge. */
	.profile-status {
		position: absolute;
		left: 43px;
		bottom: 11px;
		pointer-events: none;
	}

	.profile-top {
		overflow: clip;
		/* Room for focus rings, which would otherwise be cut by the clip during the height animation. */
		overflow-clip-margin: 4px;
	}

	/*
	 * The 24px social glyphs sit in 40px hover cells, so 8px of each cell is empty space.
	 * The gap and bottom padding subtract it, keeping the visible spacing at the card's 12px.
	 */
	.profile-actions {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px 12px 4px;
	}

	.profile-buttons {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	/* Pills, like the page's other buttons. */
	.profile-compose,
	.profile-copy,
	.profile-send,
	.profile-done {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 40px;
		border-radius: 999px;
		font-size: 15px;
		font-weight: 600;
		white-space: nowrap;
		transition:
			background-color 150ms ease-out,
			scale 120ms ease-out;
	}

	.profile-compose,
	.profile-send,
	.profile-done {
		background: #000;
		color: #fff;
	}

	.profile-compose,
	.profile-copy {
		/* 2px less on the icon side: an icon's edge reads further out than text, so equal padding looks lopsided. */
		padding: 0 16px 0 14px;
	}

	/* The secondary pill: the same tint the fields and hover cells use, so it sits under compose. */
	.profile-copy {
		background: rgb(46 46 46 / 0.06);
		color: var(--color-text);
	}

	/* A fallback address is long; let it shrink rather than push past the card. */
	.profile-copy-label {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* The two glyphs share one cell and cross-fade, the tick blooming in from small. */
	.profile-copy-icons {
		display: grid;
		flex-shrink: 0;
	}

	.profile-copy-icons img {
		grid-area: 1 / 1;
		transition:
			opacity 150ms ease-out,
			scale 200ms var(--ease-out),
			filter 150ms ease-out;
	}

	.profile-copy-icons img:last-child,
	.profile-copy[data-copied] .profile-copy-icons img:first-child {
		opacity: 0;
		scale: 0.5;
		filter: blur(2px);
	}

	.profile-copy[data-copied] .profile-copy-icons img:last-child {
		opacity: 1;
		scale: 1;
		filter: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.profile-copy-icons img {
			transition: opacity 150ms ease-out;
		}

