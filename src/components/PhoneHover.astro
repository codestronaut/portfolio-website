---
import ProjectLogo from './ProjectLogo.astro';
import { projects, type ProjectId } from '../data/portfolio';

type Point = readonly [number, number];

interface Props {
	project: ProjectId;
	/** Top-left corners inside the hero stage, in design units. */
	phone: Point;
	logo: Point;
	card: Point;
}

const { project, phone, logo, card } = Astro.props;
const { name, kind, description } = projects[project];
const cardId = `phone-card-${project}`;
---

<div
	class="hotspot"
	tabindex="0"
	aria-label={name}
	aria-describedby={cardId}
	style={`--phone-x: ${phone[0]}; --phone-y: ${phone[1]}; --logo-x: ${logo[0]}; --logo-y: ${logo[1]}; --card-x: ${card[0]}; --card-y: ${card[1]}`}
	data-side={card[0] < phone[0] ? 'left' : 'right'}
>
	<div class="hit hit--phone"></div>
	<div class="hit hit--logo"></div>
	<div class="safe"></div>
	<div class="card" id={cardId}>
		<div class="card-header">
			<ProjectLogo project={project} size="card" />
			<p class="card-name">{name}</p>
			<span class:list={['card-tag', `card-tag--${kind.toLowerCase()}`]}>{kind}</span>
		</div>
		<p class="card-description">{description}</p>
	</div>
</div>

<script>
	type Point = [number, number];

	// How long the pointer may rest inside the triangle before the phones beneath take over.
	const DWELL = 250;

	const cross = (o: Point, a: Point, b: Point) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);

	function hull(points: Point[]) {
		const sorted = [...points].sort((a, b) => a[0] - b[0] || a[1] - b[1]);
		const half = (list: Point[]) =>
			list.reduce<Point[]>((acc, p) => {
				while (acc.length >= 2 && cross(acc[acc.length - 2], acc[acc.length - 1], p) <= 0) acc.pop();
				return [...acc, p];
			}, []);
		const lower = half(sorted);
		const upper = half(sorted.reverse());
		return [...lower.slice(0, -1), ...upper.slice(0, -1)];
	}

	// iOS leaves focus where it is when a tap lands on something that can't take it, so a tap on
	// empty space wouldn't close the card. Tapping another phone still moves focus on its own.
	document.addEventListener('pointerdown', (event) => {
		const active = document.activeElement as HTMLElement | null;
		const open = active?.closest('.hotspot');
		if (open && !open.contains(event.target as Node)) active!.blur();
	});

	for (const hotspot of document.querySelectorAll<HTMLElement>('.hotspot')) {
		const card = hotspot.querySelector<HTMLElement>('.card')!;
		const safe = hotspot.querySelector<HTMLElement>('.safe')!;
		let timer: ReturnType<typeof setTimeout> | undefined;
		let closest = Infinity;

		const disarm = () => {
			clearTimeout(timer);
			safe.style.pointerEvents = '';
		};

		const distanceToCard = (x: number, y: number) => {
			const r = card.getBoundingClientRect();
			return Math.hypot(Math.max(r.left - x, 0, x - r.right), Math.max(r.top - y, 0, y - r.bottom));
		};

		hotspot.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse') return;
			const { clientX: x, clientY: y, target } = event;

			// Inside the triangle: keep it while the pointer closes in, drop it on a pause or a turn.
			if (target === safe) {
				const distance = distanceToCard(x, y);
				if (distance > closest + 4) return disarm();
				closest = Math.min(closest, distance);
				clearTimeout(timer);
				timer = setTimeout(disarm, DWELL);
				return;
			}

			// On the phone or logo: aim a fresh triangle from here at the card.
			if (!(target as Element).closest('.hit')) return;
			const stage = safe.getBoundingClientRect();
			const r = card.getBoundingClientRect();
			const corners: Point[] = [
				[r.left, r.top],
				[r.right, r.top],
				[r.right, r.bottom],
				[r.left, r.bottom],
			];
			const polygon = hull([[x, y], ...corners]).map(([px, py]) => `${px - stage.left}px ${py - stage.top}px`);
			safe.style.clipPath = `polygon(${polygon.join(', ')})`;
			safe.style.pointerEvents = 'auto';
			closest = distanceToCard(x, y);
			clearTimeout(timer);
		});

		hotspot.addEventListener('pointerleave', disarm);

		// A second tap on the phone or logo of the open project closes it again. Whether it was open
		// is read on the way down, since by the click the tap has already focused it.
		let retap = false;
		hotspot.addEventListener('pointerdown', (event) => {
			retap =
				event.pointerType !== 'mouse' &&
				hotspot.contains(document.activeElement) &&
				Boolean((event.target as Element).closest('.hit'));
		});
		hotspot.addEventListener('click', () => {
			if (retap) (document.activeElement as HTMLElement).blur();
			retap = false;
		});
	}
</script>

<style>
	/*
	 * The hotspot spans the whole stage but only its phone and logo shapes take the pointer.
	 * It sets no z-index, so every hit area shares one layer, stacked in the phones' paint
	 * order, and every card floats above all of them.
	 */
	.hotspot {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* iOS would otherwise flash a grey box over the whole stage on tap. */
		-webkit-tap-highlight-color: transparent;
	}

	.hit {
		position: absolute;
		z-index: 1;
		pointer-events: auto;
	}

	/*
	 * Convex hull of the phone in the mockup, traced from its alpha channel and grown by
	 * 6 design units so a cursor grazing the bezel still counts. The margin also covers the
	 * phone while it's lifted on hover.
	 */
	.hit--phone {
		left: calc(var(--phone-x) * var(--u));
		top: calc(var(--phone-y) * var(--u));
		width: calc(500.207 * var(--u));
		height: calc(501.944 * var(--u));
		clip-path: polygon(
			9.6% 90%, 38.6% 12.7%, 41.4% 8.4%, 46.4% 5.2%, 82.3% 0.7%, 85.2% 1.4%, 89.7% 6.2%, 90.4% 8.5%,
			90.1% 11.6%, 61.3% 87.6%, 57.8% 92.2%, 54% 94.6%, 50.4% 95.6%, 16.3% 99.2%, 13.3% 97.6%, 9.7% 92.4%
		);
	}

	.hit--logo {
		left: calc(var(--logo-x) * var(--u));
		top: calc(var(--logo-y) * var(--u));
		width: var(--logo-size);
		height: var(--logo-size);
		border-radius: 25.6%;
	}

	/* The same 6-unit margin, on a pseudo-element so the focus ring stays on the icon's edge. */
	.hit--logo::before {
		content: '';
		position: absolute;
		inset: calc(-6 * var(--u));
		border-radius: 25.6%;
	}

	/* The stage-sized box would make a meaningless ring, so the app icon carries it instead. */
	.hotspot:focus-visible {
		outline: none;
	}

	.hotspot:focus-visible .hit--logo {
		outline: 2px solid #4988c4;
		outline-offset: 4px;
	}

	/*
	 * The card is interactive, so it only takes the pointer while shown. `visibility` flips
	 * after the fade, which keeps it reachable through the 100ms grace period on the way out.
	 */
	.card {
		position: absolute;
		z-index: 2;
		left: calc(var(--card-x) * var(--u));
		top: calc(var(--card-y) * var(--u));
		width: 280px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		background: var(--color-surface);
		border-radius: 20px;
		box-shadow: var(--shadow-float);
		/* The logo's glass sits on the card's white rather than the page colour. */
		--glass-base: var(--color-surface);
		pointer-events: auto;
		visibility: hidden;
		opacity: 0;
		translate: var(--enter-x, 0) 0;
		scale: 0.97;
		transform-origin: var(--origin, left top);
		transition:
			opacity 150ms ease-out 100ms,
			translate 150ms ease-out 100ms,
			scale 150ms ease-out 100ms,
			visibility 0s linear 250ms;
	}

	/* Moving straight onto another phone swaps the cards without the grace period. */
	:global(.stage):has(.hotspot:hover) .card {
		transition:
			opacity 150ms ease-out,
			translate 150ms ease-out,
			scale 150ms ease-out,
			visibility 0s linear 150ms;
	}

	/*
	 * Hover intent: while the pointer heads for its open card, the script below clips this
	 * layer to a triangle from the pointer to the card. It belongs to the hotspot, so the card
	 * stays open even where the path crosses another phone.
	 */
	.safe {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	.hotspot[data-side='right'] .card {
		--enter-x: -6px;
		--origin: left top;
	}

	.hotspot[data-side='left'] .card {
		--enter-x: 6px;
		--origin: right top;
	}

	/*
	 * Shown on hover, while keyboard focus is on the hotspot or inside the card, and on touch
	 * screens while a tap has focus anywhere in it. Tapping elsewhere closes it.
	 */
	.hotspot:is(:focus-visible, :has(:focus-visible)) .card {
		visibility: visible;
		opacity: 1;
		translate: 0 0;
		scale: 1;
		transition:
			opacity 220ms var(--ease-out),
			translate 220ms var(--ease-out),
			scale 220ms var(--ease-out),
			visibility 0s;
	}

	@media (hover: hover) {
		.hotspot:hover .card {
			visibility: visible;
			opacity: 1;
			translate: 0 0;
			scale: 1;
			transition:
				opacity 220ms var(--ease-out),
				translate 220ms var(--ease-out),
				scale 220ms var(--ease-out),
				visibility 0s;
		}
	}

	@media (hover: none) {
		.hotspot:focus-within .card {
			visibility: visible;
			opacity: 1;
			translate: 0 0;
			scale: 1;
			transition:
				opacity 220ms var(--ease-out),
				translate 220ms var(--ease-out),
				scale 220ms var(--ease-out),
				visibility 0s;
		}
	}

	/*
	 * Below this width the side cards would leave the viewport, so they sit over the phone
	 * instead, clamped to the stage's edges.
	 */
	@media (max-width: 1399px) {
		.card {
			left: clamp(0px, calc((var(--phone-x) + 250) * var(--u) - 140px), calc(100% - 280px));
			top: calc((var(--phone-y) + 235) * var(--u));
			transform-origin: center top;
		}

		.hotspot[data-side] .card {
			--enter-x: 0;
		}
	}

	/* No movement and no fade; the delays stay, so the grace period still works. */
	@media (prefers-reduced-motion: reduce) {
		.card {
			translate: none !important;
			scale: none !important;
			transition-duration: 0s !important;
		}
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.card-name {
		font-size: 17px;
		font-weight: 600;
		white-space: nowrap;
	}

	.card-tag {
		padding: 3px 8px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 500;
		line-height: 18px;
		white-space: nowrap;
	}

	.card-tag--personal {
		color: #6d28d9;
		background: rgb(109 40 217 / 0.1);
	}

	.card-tag--client {
		color: #c2410c;
		background: rgb(194 65 12 / 0.1);
	}

	.card-description {
		font-size: 15px;
		line-height: 1.4;
		color: var(--color-text-muted);
	}
</style>
