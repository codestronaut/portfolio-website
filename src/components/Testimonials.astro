---
import { testimonials } from '../data/portfolio';

import arrowLeft from '../assets/icons/arrow-square-left.svg';
import arrowRight from '../assets/icons/arrow-square-right.svg';

const total = testimonials.length;
---

<section class="testimonials" aria-labelledby="testimonials-label" data-testimonials>
	<div class="testimonials-header">
		<h2 class="section-label" id="testimonials-label">Kind words</h2>
		<div class="testimonials-controls">
			<p class="section-label" aria-live="polite"><span data-current>1</span> / {total}</p>
			<div class="testimonials-buttons">
				<button type="button" class="arrow" aria-label="Previous testimonial" data-prev disabled>
					<img src={arrowLeft.src} width={arrowLeft.width} height={arrowLeft.height} alt="" />
				</button>
				<button type="button" class="arrow" aria-label="Next testimonial" data-next disabled={total < 2}>
					<img src={arrowRight.src} width={arrowRight.width} height={arrowRight.height} alt="" />
				</button>
			</div>
		</div>
	</div>
	<div class="testimonials-slides reveal">
		{
			testimonials.map(({ quote, name, title, location }, i) => (
				<figure class="testimonial" hidden={i !== 0} data-side={i > 0 ? 'after' : undefined} data-slide>
					<div class="testimonial-body">
						<blockquote id={`testimonial-quote-${i}`}>“{quote}”</blockquote>
						<button
							type="button"
							class="testimonial-more"
							aria-expanded="false"
							aria-controls={`testimonial-quote-${i}`}
							hidden
							data-more
						>
							Read more
						</button>
					</div>
					<figcaption>
						<span class="testimonial-name">{name}</span>
						<span class="testimonial-title">{title}</span>
						<span class="testimonial-location">
							<img
								class="flag"
								src={location.flag.src}
								width="18"
								height="12"
								alt={location.country === location.name ? '' : location.country}
							/>
							{location.name}
						</span>
					</figcaption>
				</figure>
			))
		}
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-testimonials]')) {
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const current = root.querySelector('[data-current]')!;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let index = 0;

		const parts = (slide: HTMLElement) => ({
			quote: slide.querySelector('blockquote')!,
			more: slide.querySelector<HTMLButtonElement>('[data-more]')!,
		});

		// The quote's height animates between the clamp and its full length; a hidden slide just snaps.
		const setExpanded = (slide: HTMLElement, expanded: boolean) => {
			if (slide.hasAttribute('data-expanded') === expanded) return;
			const { quote, more } = parts(slide);
			const from = quote.offsetHeight;
			slide.toggleAttribute('data-expanded', expanded);
			more.setAttribute('aria-expanded', String(expanded));
			more.textContent = expanded ? 'Read less' : 'Read more';
			if (reducedMotion.matches || slide.hidden) return;
			quote.animate(
				{ height: [`${from}px`, `${quote.offsetHeight}px`] },
				{ duration: expanded ? 300 : 240, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
			);
		};

		// Only a quote that runs past the clamp gets the button. How many lines it takes depends on
		// the column's width and the loaded font, so this reruns on resize and once fonts are in.
		const measure = () => {
			for (const slide of slides) {
				if (slide.hasAttribute('data-expanded')) continue;
				const { quote, more } = parts(slide);
				more.hidden = quote.scrollHeight <= quote.clientHeight + 1;
			}
		};

		// Hidden slides wait on the side they'd come in from, so the one being left slides out one way
		// and the next comes in from the other. The slide being left also folds back, so every slide
		// starts from the same reserved height.
		const show = (i: number) => {
			index = Math.max(0, Math.min(slides.length - 1, i));
			slides.forEach((slide, n) => {
				slide.hidden = n !== index;
				if (n === index) delete slide.dataset.side;
				else slide.dataset.side = n < index ? 'before' : 'after';
			});
			slides.forEach((slide, n) => n !== index && setExpanded(slide, false));
			current.textContent = String(index + 1);
			prev.disabled = index === 0;
			next.disabled = index === slides.length - 1;
		};

		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));
		for (const slide of slides) {
			parts(slide).more.addEventListener('click', () => setExpanded(slide, !slide.hasAttribute('data-expanded')));
		}

		new ResizeObserver(measure).observe(root.querySelector('.testimonials-slides')!);
		document.fonts.ready.then(measure);
	}
</script>

<style>
	.testimonials {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.testimonials-header {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.testimonials-header h2 {
		flex: 1;
	}

	.testimonials-controls {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.testimonials-controls p {
		font-variant-numeric: tabular-nums;
	}

	.testimonials-buttons {
		display: flex;
	}

	.arrow {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		transition:
			opacity 150ms ease-out,
			scale 120ms ease-out;
	}

	.arrow + .arrow {
		margin-left: -4px;
	}

	.arrow img {
		width: 32px;
		height: 32px;
	}

	.arrow:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.arrow:not(:disabled):active {
		scale: 0.94;
	}

	/*
	 * Every slide shares one cell and the hidden ones keep their space, so the section is as tall
	 * as the longest quote and switching slides doesn't move the page below.
	 */
	.testimonials-slides {
		display: grid;
	}

	/*
	 * Moving between slides, the one leaving fades and slips 12px toward the side it's going, fast
	 * and quiet, and the next resolves in from the other side as it clears; overlapping lines of
	 * text would be unreadable. Transitions rather than keyframes, so clicking again mid-swap turns
	 * around from wherever the slides are.
	 */
	.testimonial {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: 24px;
		transition:
			opacity 260ms var(--ease-out) 100ms,
			translate 260ms var(--ease-out) 100ms,
			filter 260ms var(--ease-out) 100ms,
			visibility 0s;
	}

	.testimonial[hidden] {
		visibility: hidden;
		opacity: 0;
		filter: blur(2px);
		transition:
			opacity 120ms ease-in,
			translate 120ms ease-in,
			filter 120ms ease-in,
			visibility 0s linear 120ms;
	}

	.testimonial[data-side='before'] {
		translate: -12px 0;
	}

	.testimonial[data-side='after'] {
		translate: 12px 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial,
		.testimonial[hidden] {
			translate: none;
			filter: none;
			transition: none;
		}
	}

	.testimonial-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	/* Long quotes stop at four lines, with an ellipsis, until Read more opens them. */
	blockquote {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
		line-clamp: 4;
		overflow: hidden;
		font-size: var(--text-quote);
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: var(--tracking-quote);
		text-wrap: pretty;
	}

	.testimonial[data-expanded] blockquote {
		-webkit-line-clamp: unset;
		line-clamp: none;
	}

	.testimonial-more {
		position: relative;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-text-muted);
		transition: color 150ms ease-out;
	}

	/* A 44px-tall hit area around the short label. */
	.testimonial-more::before {
		content: '';
		position: absolute;
		inset: -12px -8px;
	}

	.testimonial-more[hidden] {
		display: none;
	}

	@media (hover: hover) {
		.testimonial-more:hover {
			color: var(--color-text);
		}
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		row-gap: 4px;
		font-size: var(--text-body);
	}

	.testimonial-name {
		font-weight: 600;
	}

	.testimonial-title,
	.testimonial-location {
		color: var(--color-text-muted);
	}

	.testimonial-title::before,
	.testimonial-location::before {
		content: '•';
		margin-inline: 12px;
	}

	/* The flag sits before the place, as in the footer. */
	.testimonial-location {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.testimonial-location::before {
		margin-right: 6px;
	}

	/* Too narrow for one line, the place drops below the name and role, without its bullet. */
	@container content (max-width: 680px) {
		.testimonial-location {
			flex-basis: 100%;
		}

		.testimonial-location::before {
			content: none;
		}
	}
</style>
