---
import { Image } from 'astro:assets';
import PhoneHover from './PhoneHover.astro';
import ProjectLogo from './ProjectLogo.astro';
import { projects } from '../data/portfolio';

// Positions in design units on the 896 × 680 stage. Paint order matches Figma:
// each logo sits behind its phone, and later groups sit in front of earlier ones.
// Each hotspot lives in its group, so hit areas stack in that same order and the
// frontmost phone wins where they overlap.
const groups = [
	// Each card sits 12 units outside its group, top-aligned with the logo. The card is
	// 280px wide, and these side positions only apply at widths where a unit is 1px.
	// `fan` is how far, in units, the group drifts as the hero scrolls away.
	{ project: 'tribel', phone: [396, 178.06], logo: [710, 452], card: [847, 452], fan: [28, 10] },
	{ project: 'hoppr', phone: [253.49, 0], logo: [347, 44], card: [717, 44], fan: [0, -18] },
	{ project: 'paglyph', phone: [0, 177.7], logo: [46, 335], card: [-246, 335], fan: [-28, 10] },
] as const;
---

<div class="hero-phones">
	<div class="stage">
		{
			groups.map((group) => {
				const { project, phone, logo, fan } = group;
				return (
					<div class="group" style={`--fan-x: ${fan[0]}; --fan-y: ${fan[1]}`}>
						<div class="item" style={`--x: ${logo[0]}; --y: ${logo[1]}`}>
							<ProjectLogo project={project} size="large" />
						</div>
						<Image
							src={projects[project].mockup}
							alt={`${projects[project].name} app on iPhone`}
							width={501}
							densities={[1, 2, 3]}
							quality={90}
							loading="eager"
							fetchpriority="high"
							class="item phone"
							style={`--x: ${phone[0]}; --y: ${phone[1]}`}
						/>
						<PhoneHover {...group} />
					</div>
				);
			})
		}
	</div>
</div>

<style>
	.hero-phones {
		container-type: inline-size;
		width: min(896.21px, 100%);
		margin-inline: auto;
	}

	.stage {
		--u: calc(100cqw / 896.21);
		--logo-size: calc(125 * var(--u));
		/*
		 * Grayscale, then contrast toward mid-grey and a slight lift: black lands near 27% and
		 * white near 93%, a touch under the page, so the active project's whites stand out.
		 */
		--dimmed: grayscale(1) contrast(0.55) brightness(1.2);
		/*
		 * The lift reacts with the snappy ease-out; colour fades on a gentler `ease`, since a
		 * strong ease-out does most of a colour change in the first frames and reads as a snap.
		 * Settling back waits out the card's 100ms grace and runs a little faster than going in.
		 */
		--item-react:
			translate 200ms var(--ease-out),
			filter 250ms ease;
		--item-settle:
			translate 150ms ease-out 100ms,
			filter 200ms ease 100ms;
		position: relative;
		height: calc(680 * var(--u));
	}

	/* Groups only scope the hover states; `contents` keeps every item positioned against the stage. */
	.group {
		display: contents;
	}

	/* At rest the lift, the dimming and the card all leave together after the grace period. */
	.item {
		position: absolute;
		left: calc(var(--x) * var(--u));
		top: calc(var(--y) * var(--u));
		transition: var(--item-settle);
	}

	/* Moving straight onto another project swaps everything without the grace period. */
	.stage:has(:global(.hotspot):hover) .item {
		transition-delay: 0s;
	}

	/*
	 * While a project is active, it rises a little and the others turn grey and wash out toward
	 * the page.
	 * A filter keeps them opaque: with opacity, a dimmed phone in front (Paglyph over Hoppr)
	 * would turn see-through and ghost the active phone behind it.
	 * "Active" matches whatever opens the card: hover, keyboard focus, or a tap on touch.
	 */
	.group:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible)) .item,
	.stage:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible))
		.group:not(:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible)))
		.item {
		transition: var(--item-react);
	}

	.group:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible)) .item {
		translate: 0 calc(-6 * var(--u));
	}

	.stage:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible))
		.group:not(:has(:global(.hotspot:focus-visible), :global(.hotspot :focus-visible)))
		.item {
		filter: var(--dimmed);
	}

	@media (hover: hover) {
		.group:has(:global(.hotspot):hover) .item,
		.stage:has(:global(.hotspot):hover) .group:not(:has(:global(.hotspot):hover)) .item {
			transition: var(--item-react);
		}

		.group:has(:global(.hotspot):hover) .item {
			translate: 0 calc(-6 * var(--u));
		}

		.stage:has(:global(.hotspot):hover) .group:not(:has(:global(.hotspot):hover)) .item {
			filter: var(--dimmed);
		}
	}

	@media (hover: none) {
		.group:has(:global(.hotspot):focus-within) .item,
		.stage:has(:global(.hotspot):focus-within) .group:not(:has(:global(.hotspot):focus-within)) .item {
			transition: var(--item-react);
		}

		.group:has(:global(.hotspot):focus-within) .item {
			translate: 0 calc(-6 * var(--u));
		}

		.stage:has(:global(.hotspot):focus-within) .group:not(:has(:global(.hotspot):focus-within)) .item {
			filter: var(--dimmed);
		}
	}

	/*
	 * Promote the items as soon as the pointer is over the hero, before it reaches a phone,
	 * so the grey fade runs on the compositor from its first frame instead of repainting the
	 * large phone images every frame.
	 */
	@media (hover: hover) {
		.hero-phones:hover .item {
			will-change: filter;
		}
	}

	/*
	 * As the hero scrolls away the phones fan out, each group drifting its own way, tied 1:1 to the
	 * scroll so scrolling back folds them in again. It runs on `transform`, which stacks with the
	 * hover lift on `translate`. The hit areas, the hover-intent layer and the card move with their
	 * phone so hovering stays lined up; the hotspot itself stays put, since transforming it would
	 * give it a stacking context and trap its card under the next group's hit areas.
	 */
	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.item,
			.group :global(:is(.hit, .safe, .card)) {
				animation: fan linear both;
				animation-timeline: scroll(root);
				animation-range: 0 70vh;
			}
		}
	}

	@keyframes fan {
		to {
			transform: translate(calc(var(--fan-x) * var(--u)), calc(var(--fan-y) * var(--u)));
		}
	}

	/* The dimming is a state, not motion, so it stays; only the movement and fades go. */
	@media (prefers-reduced-motion: reduce) {
		.item {
			translate: none !important;
			transition-duration: 0s !important;
		}
	}

	.phone {
		width: calc(500.207 * var(--u));
		height: calc(501.944 * var(--u));
		pointer-events: none;
	}
</style>
