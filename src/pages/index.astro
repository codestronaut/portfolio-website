---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroPhones from '../components/HeroPhones.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import Profile from '../components/Profile.astro';
import Testimonials from '../components/Testimonials.astro';
import { achievements, contact, experience, profile, tools } from '../data/portfolio';

import smsTracking from '../assets/figma/sms-tracking.svg';
import arrowUpRight from '../assets/figma/arrow-up-right.svg';
import arrowUp from '../assets/figma/arrow-up.svg';
import flagIndonesia from '../assets/figma/flag-indonesia.svg';
import currentDot from '../assets/figma/dot.svg';
---

<Layout>
	<main id="top">
		<section class="hero">
			<div class="hero-intro">
				<h1 class="hero-title">
					<span class="hero-title-first">
						<span>I design, build, and ship</span>
						<span class="hero-logos" aria-hidden="true">
							<ProjectLogo project="tribel" size="inline" class="hero-logo hero-logo--ccw" />
							<ProjectLogo project="hoppr" size="inline" class="hero-logo hero-logo--cw" />
							<ProjectLogo project="paglyph" size="inline" class="hero-logo hero-logo--ccw" />
						</span>
						<span class="hero-title-medium"><strong>mobile apps</strong>.</span>
					</span>
					<span class="hero-title-line">I move fast, while ensuring the highest level of craft,</span>
					<span class="hero-title-line">attention to detail, and performance.</span>
				</h1>
				<a class="button button--dark" href="#contact">
					<img src={smsTracking.src} width={smsTracking.width} height={smsTracking.height} alt="" />
					Get in touch
				</a>
			</div>
			<HeroPhones />
		</section>

		<div class="content">
			<section class="achievements" aria-label="Achievements">
				{
					achievements.map(({ value, label }, i) => (
						<>
							{i > 0 && <div class="achievements-divider" />}
							<div class="achievement">
								<p class="achievement-value">{value}</p>
								<p class="achievement-label">{label}</p>
							</div>
						</>
					))
				}
			</section>

			<section class="stack" aria-labelledby="experience-label">
				<h2 class="section-label" id="experience-label">Experience</h2>
				<ol class="experience">
					{
						experience.map(({ period, role, company, current }) => (
							<li class="experience-row">
								<p class="experience-period">
									{current && (
										<img
											class="experience-current"
											src={currentDot.src}
											width={currentDot.width}
											height={currentDot.height}
											alt="Current:"
										/>
									)}
									{period}
								</p>
								<p class="experience-role">{role}</p>
								<p class="experience-company">{company}</p>
							</li>
						))
					}
				</ol>
			</section>

			<Testimonials />

			<section class="stack" aria-labelledby="tools-label">
				<h2 class="section-label" id="tools-label">Tools I use</h2>
				<ul class="tools">
					{
						tools.map(({ name, icon, crop }) => (
							<li class="tool">
								<span class:list={['tool-icon', { 'tool-icon--crop': crop }]}>
									<Image src={icon} alt="" width={28} densities={[1, 2, 3]} />
								</span>
								{name}
							</li>
						))
					}
				</ul>
			</section>

			<section class="stack" id="contact" aria-labelledby="cta-title">
				<div class="cta">
					<h2 class="cta-title" id="cta-title">Have something<br />worth building?</h2>
					<a class="button button--light" href={`mailto:${contact.email}`}>
						Say hello
						<img src={arrowUpRight.src} width={arrowUpRight.width} height={arrowUpRight.height} alt="" />
					</a>
				</div>
				<footer class="footer">
					<p>© 2026 {profile.name}</p>
					<p class="footer-built">
						Built in Lombok
						<img src={flagIndonesia.src} width={flagIndonesia.width} height={flagIndonesia.height} alt="Indonesia" />
						for a global audience
					</p>
					<a class="footer-top" href="#top">
						Back to top
						<img src={arrowUp.src} width={arrowUp.width} height={arrowUp.height} alt="" />
					</a>
				</footer>
			</section>
		</div>
	</main>

	<Profile />
</Layout>

<style>
	main {
		padding: 64px var(--gutter);
	}

	/* Hero */

	.hero {
		display: flex;
		flex-direction: column;
		gap: clamp(56px, 28.26px + 7.396vw, 104px);
	}

	.hero-intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
	}

	.hero-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: var(--content-width);
		font-size: var(--text-title);
		font-weight: 600;
		/*
		 * The spacing lives in the line height, not a gap between lines, so a line that wraps
		 * on a narrow screen keeps the same rhythm as the breaks between lines.
		 */
		line-height: 1.55;
		letter-spacing: var(--tracking-title);
		text-align: center;
		text-wrap: balance;
	}

	.hero-title-first {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0 8px;
	}

	.hero-title-medium {
		font-weight: 500;
	}

	.hero-title-medium strong {
		font-weight: 700;
	}

	/* The 40px logos overhang a short line rather than making their row taller than the rest. */
	.hero-logos {
		display: flex;
		align-items: center;
		margin-block: -4px;
	}

	.hero-logo:not(:last-child) {
		margin-right: -8px;
	}

	.hero-logo--ccw {
		rotate: -2deg;
	}

	.hero-logo--cw {
		rotate: 2deg;
	}

	/* Buttons */

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		font-size: 17px;
		font-weight: 600;
		line-height: 24px;
		white-space: nowrap;
		transition:
			background-color 150ms ease-out,
			scale 120ms ease-out;
	}

	.button:active {
		scale: 0.97;
	}

	/* 2px less on the icon side: an icon's edge reads further out than text, so equal padding looks lopsided. */
	.button--dark {
		gap: 8px;
		padding: 14px 16px 14px 14px;
		background: #000;
		color: #fff;
	}

	.button--light {
		gap: 6px;
		width: 240px;
		height: 48px;
		background: #fff;
		color: var(--color-text);
	}

	@media (hover: hover) {
		.button--dark:hover {
			background: #2e2e2e;
		}

		.button--light:hover {
			background: rgb(255 255 255 / 0.88);
		}
	}

	/* Content column */

	/* A container, so rows that run out of room stack on the column's width, not the viewport's. */
	.content {
		container: content / inline-size;
		display: flex;
		flex-direction: column;
		gap: var(--space-section);
		max-width: var(--content-width);
		margin: clamp(72px, 39.64px + 8.629vw, 128px) auto 0;
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	/* Achievements */

	.achievements {
		display: flex;
		gap: 24px;
	}

	.achievement {
		flex: 1 0 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.achievement-value {
		font-size: var(--text-display);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: var(--tracking-display);
	}

	.achievement-label {
		font-size: var(--text-body);
		color: var(--color-text-muted);
	}

	.achievements-divider {
		flex-shrink: 0;
		width: 1px;
		background: var(--color-divider);
	}

	@media (max-width: 640px) {
		.achievements {
			gap: 16px;
		}

		.achievement-label {
			font-size: var(--text-sm);
		}
	}

	/* Experience */

	/* Rows share the list's columns through subgrid, so every role and company lines up. */
	.experience {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto;
		column-gap: 24px;
	}

	.experience-row {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: center;
		padding-block: 16px;
		border-top: 1px solid var(--color-divider);
		font-size: var(--text-body);
	}

	.experience-row:last-child {
		border-bottom: 1px solid var(--color-divider);
	}

	.experience-period,
	.experience-company {
		color: var(--color-text-muted);
	}

	.experience-period {
		position: relative;
	}

	.experience-current {
		position: absolute;
		left: -18px;
		top: 0.5lh;
		translate: 0 -50%;
	}

	.experience-role {
		font-weight: 600;
	}

	.experience-company {
		text-align: right;
	}

	@container content (max-width: 680px) {
		.experience {
			display: block;
		}

		.experience-row {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'role role'
				'period company';
			row-gap: 2px;
			column-gap: 12px;
		}

		.experience-role {
			grid-area: role;
		}

		.experience-period {
			grid-area: period;
			font-size: var(--text-sm);
		}

		.experience-company {
			grid-area: company;
			font-size: var(--text-sm);
		}

		.experience-current {
			left: -14px;
		}
	}

	/* Tools */

	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}

	.tool {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--text-body);
		white-space: nowrap;
	}

	.tool-icon {
		position: relative;
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		overflow: hidden;
		border-radius: 7px;
	}

	.tool-icon::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid var(--color-hairline);
		border-radius: inherit;
	}

	.tool-icon img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tool-icon--crop img {
		width: 106.67%;
		height: 106.67%;
		margin: -3.33%;
	}

	@media (max-width: 640px) {
		.tools {
			gap: 14px 18px;
		}
	}

	/* CTA + footer */

	.cta {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		height: 320px;
		padding: 32px;
		border-radius: 20px;
		overflow: hidden;
		background: radial-gradient(
			93% 105.16% at 26.11% 13.59%,
			#4988c4 0%,
			#7ab2d3 50%,
			#a9cce3 75%,
			#d8e6f3 100%
		);
	}

	.cta-title {
		font-size: var(--text-display);
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: var(--tracking-display);
		color: #fff;
	}

	@container content (max-width: 680px) {
		.cta {
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-end;
			height: 300px;
			padding: 24px;
		}

		.button--light {
			width: 100%;
		}
	}

	.footer {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 16px;
		font-size: var(--text-sm);
		color: var(--color-text-subtle);
	}

	.footer-built {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.footer-top {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 4px;
		color: var(--color-text-muted);
		transition: color 150ms ease-out;
	}

	@media (hover: hover) {
		.footer-top:hover {
			color: var(--color-text);
		}
	}

	@container content (max-width: 680px) {
		.footer {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 8px;
			text-align: center;
		}

		.footer-built {
			order: -1;
		}

		.footer-top {
			justify-self: center;
		}
	}
</style>
